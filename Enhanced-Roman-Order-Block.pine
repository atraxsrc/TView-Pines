//@version=6
// =============================================================================
//  Enhanced Roman Order Block                                        (rev 3)
//
//  Pattern (bullish, bearish is the mirror):
//    A  candle before the OB
//    B  the OB candle: makes a lower low than A
//    C  candle after B: holds a higher low than B
//    X  first candle whose low clears B's high (the displacement)
//  The OB is drawn on the bar where X closes, and is "mitigated" when price
//  comes back to B's high.
//
//  rev 2 changes
//   - Pine v6, one OrderBlock object per zone instead of 7 parallel arrays.
//   - Labels are owned by their OB and deleted with it (no orphan labels).
//   - Unmitigated boxes and lines keep extending with the chart.
//   - Lookback now means "bars allowed for the displacement", and every bar in
//     that window is checked. Lookback 3 finds the same OBs as before.
//   - OBs form on closed bars only (no intrabar flicker).
//   - An OB is created on the bar that clears it, so it can no longer be
//     mitigated on its own creation bar.
//   - Object limits raised to 500, Max OBs and extension inputs are capped.
//   - Max OBs evicts mitigated blocks first, then the oldest.
//   - One HTF request instead of three, colors are inputs.
//
//  rev 3 changes
//   - Optional settings guide drawn on the chart ("Guide" group, last in the
//     Inputs tab).
// =============================================================================
indicator("Enhanced Roman Order Block", "Enhanced OB", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================= INPUTS ========================================
var string gO = "Order Block Settings"
showBullishOB   = input.bool(true, "Show Bullish Order Blocks",   group = gO)
showBearishOB   = input.bool(true, "Show Bearish Order Blocks",   group = gO)
showMitigatedOB = input.bool(true, "Show Mitigated Order Blocks", group = gO,
     tooltip = "Off = a block is removed from the chart the moment it is mitigated.")
mitigationType  = input.string("Wick", "Mitigation Type", options = ["Wick", "Close"], group = gO,
     tooltip = "Wick = any touch of the block's near edge. Close = a bar must close at or beyond it (stricter, blocks live longer).")
minOBSizeATR    = input.float(0.5, "Min OB Size (ATR Multiple)", minval = 0.0, step = 0.1, group = gO,
     tooltip = "Ignores OB candles smaller than this multiple of ATR(14). Raise it to keep only big candles, 0 = no filter.")
lookback        = input.int(3, "Lookback Candles", minval = 2, maxval = 10, group = gO,
     tooltip = "How many bars price gets to clear the OB candle. 2 = only an immediate gap, 3 = classic pattern, higher = slower displacements also count (more blocks).")

var string gD = "Display Settings"
extendBars = input.int(499, "Box Extension Bars", minval = 0, maxval = 499, group = gD,
     tooltip = "How far an unmitigated block reaches past the current bar. TradingView allows at most 500 bars into the future.")
drawLines  = input.bool(true, "Draw Price Lines from OBs", group = gD)
maxOBs     = input.int(20, "Max OBs to Show", minval = 1, maxval = 200, group = gD,
     tooltip = "When the limit is hit, mitigated blocks are dropped first, then the oldest.")
cBull      = input.color(#89b4fa,     "Bullish color", group = gD)
cBear      = input.color(#fab387,     "Bearish color", group = gD)
cLabelTx   = input.color(color.white, "Label text",    group = gD)

var string gA = "Alerts"
alertOnFormation  = input.bool(false, "Alert on OB Formation",  group = gA)
alertOnMitigation = input.bool(false, "Alert on OB Mitigation", group = gA)

var string gM = "Multi-Timeframe"
htf = input.timeframe("", "Higher Timeframe for Confirmation", group = gM,
     tooltip = "Empty = off. When set, a bullish OB candle must trade at or below the previous HTF candle's low (a sweep of HTF liquidity), a bearish one at or above its high.")
useHTF = htf != ""

if useHTF and timeframe.in_seconds(htf) <= timeframe.in_seconds()
    runtime.error("Higher Timeframe must be greater than the chart's timeframe.")

// Previous CLOSED HTF candle. [1] + lookahead_on is the non-repainting pattern.
[htfHigh, htfLow] = request.security(syminfo.tickerid, htf, [high[1], low[1]], lookahead = barmerge.lookahead_on)

// ============================= STATE =========================================
type OrderBlock
    box   bx
    line  top
    line  bot
    label lb
    bool  isBull
    float level                // price that mitigates the block
    bool  mitigated = false

var array<OrderBlock> obs = array.new<OrderBlock>()

method wipe(OrderBlock this) =>
    box.delete(this.bx)
    line.delete(this.top)
    line.delete(this.bot)
    label.delete(this.lb)

f_newOB(bool isBull, int left, float top, float bot, float gap) =>
    color c = isBull ? cBull : cBear
    int right = bar_index + extendBars
    OrderBlock o = OrderBlock.new()
    o.isBull := isBull
    o.level  := isBull ? top : bot
    o.bx     := box.new(left, top, right, bot, border_color = c, border_width = 1, bgcolor = color.new(c, 90))
    o.lb     := label.new(left, isBull ? bot - gap : top + gap, "OB", color = c, textcolor = cLabelTx,
         style = isBull ? label.style_label_up : label.style_label_down, size = size.small)
    if drawLines
        o.top := line.new(left, top, right, top, color = c, style = line.style_dashed)
        o.bot := line.new(left, bot, right, bot, color = c, style = line.style_dashed)
    o

atrVal  = ta.atr(14)
minSize = atrVal * minOBSizeATR
pad     = atrVal * 0.1

// ============================= MANAGE EXISTING BLOCKS ========================
// Runs before detection, so a block is never tested on its own creation bar.
if obs.size() > 0
    for i = obs.size() - 1 to 0
        OrderBlock o = obs.get(i)
        if not o.mitigated
            bool hit = false
            if mitigationType == "Wick"
                hit := o.isBull ? low <= o.level : high >= o.level
            else
                hit := barstate.isconfirmed and (o.isBull ? close <= o.level : close >= o.level)

            if hit
                o.mitigated := true
                box.set_right(o.bx, bar_index)
                line.set_x2(o.top, bar_index)
                line.set_x2(o.bot, bar_index)
                if alertOnMitigation
                    alert((o.isBull ? "Bullish" : "Bearish") + " Order Block Mitigated at " + str.tostring(o.level, format.mintick),
                         alert.freq_once_per_bar_close)
                if not showMitigatedOB
                    o.wipe()
                    obs.remove(i)
            else
                // still live: keep it reaching past the current bar
                box.set_right(o.bx, bar_index + extendBars)
                line.set_x2(o.top, bar_index + extendBars)
                line.set_x2(o.bot, bar_index + extendBars)

// ============================= DETECT NEW BLOCKS =============================
// k = how many bars back the OB candle (B) sits. The current bar is the one
// that clears it, and no earlier bar may have cleared it already, so every OB
// candle is reported exactly once.
if barstate.isconfirmed
    for k = 1 to lookback - 1
        float bH = high[k]
        float bL = low[k]
        if bH - bL >= minSize
            bool bull = showBullishOB and bL < low[k + 1]  and low[k - 1]  > bL and low  > bH
            bool bear = showBearishOB and bH > high[k + 1] and high[k - 1] < bH and high < bL

            if (bull or bear) and k > 1
                for j = 1 to k - 1
                    if low[j] > bH
                        bull := false
                    if high[j] < bL
                        bear := false

            if bull and (not useHTF or bL <= htfLow[k])
                obs.push(f_newOB(true, bar_index - k, bH, bL, pad))
                if alertOnFormation
                    alert("Bullish Order Block Formed at " + str.tostring(bL, format.mintick), alert.freq_once_per_bar_close)

            if bear and (not useHTF or bH >= htfHigh[k])
                obs.push(f_newOB(false, bar_index - k, bH, bL, pad))
                if alertOnFormation
                    alert("Bearish Order Block Formed at " + str.tostring(bH, format.mintick), alert.freq_once_per_bar_close)

// ============================= ENFORCE MAX ===================================
// Drop the oldest mitigated block first. Only when none is mitigated does the
// oldest live block go.
while obs.size() > maxOBs
    int idx = 0
    for [j, o] in obs
        if o.mitigated
            idx := j
            break
    OrderBlock gone = obs.remove(idx)
    gone.wipe()

// ============================= SETTINGS GUIDE ================================
// A cheat sheet drawn on the chart: "if you want X, change Y", with the values
// you have right now. These inputs are declared last on purpose, so settings
// already saved on a chart keep their place when the script is updated.
var string gG = "Guide"
showGuide  = input.bool(false, "Show settings guide on chart", group = gG,
     tooltip = "Draws a cheat sheet on the chart: what to change for a given goal, with your current values in brackets. Untick to hide it.")
guidePosIn = input.string("Bottom left", "Guide position", options = ["Top left", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom right"], group = gG)
guideSzIn  = input.string("Small", "Guide text size", options = ["Tiny", "Small", "Normal", "Large"], group = gG)

guidePos = switch guidePosIn
    "Top left"     => position.top_left
    "Top right"    => position.top_right
    "Middle left"  => position.middle_left
    "Middle right" => position.middle_right
    "Bottom right" => position.bottom_right
    => position.bottom_left
guideSz = switch guideSzIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    => size.small

color cGuideBg = color.new(#1E222D, 10)
color cGuideTx = #D1D4DC
color cGuideHd = color.new(color.gray, 75)

var table guide = table.new(guidePos, 2, 10, bgcolor = cGuideBg,
     border_color = color.new(color.gray, 60), border_width = 1,
     frame_color = color.new(color.gray, 50), frame_width = 1)

gRow(int r, string want, string change) =>
    table.cell(guide, 0, r, want,   text_color = cGuideTx, text_size = guideSz, text_halign = text.align_left)
    table.cell(guide, 1, r, change, text_color = cGuideTx, text_size = guideSz, text_halign = text.align_left)

if showGuide and barstate.islast
    table.cell(guide, 0, 0, "Enhanced OB: if you want...", text_color = cGuideTx, text_size = guideSz, text_halign = text.align_left, bgcolor = cGuideHd)
    table.cell(guide, 1, 0, "...change this  [current value]", text_color = cGuideTx, text_size = guideSz, text_halign = text.align_left, bgcolor = cGuideHd)
    gRow(1, "Fewer, stronger blocks",        "Raise 'Min OB Size (ATR Multiple)' toward 1.0  [" + str.tostring(minOBSizeATR) + "]")
    gRow(2, "More blocks",                   "Lower 'Min OB Size', raise 'Lookback Candles'  [" + str.tostring(lookback) + "]")
    gRow(3, "Blocks that survive a wick",    "'Mitigation Type' = Close  [" + mitigationType + "]")
    gRow(4, "Used blocks removed",           "Untick 'Show Mitigated Order Blocks'  [" + (showMitigatedOB ? "ticked" : "unticked") + "]")
    gRow(5, "Shorter live boxes",            "Lower 'Box Extension Bars', try 50  [" + str.tostring(extendBars) + "]")
    gRow(6, "Less line clutter",             "Untick 'Draw Price Lines from OBs'  [" + (drawLines ? "ticked" : "unticked") + "]")
    gRow(7, "Fewer blocks on screen",        "Lower 'Max OBs to Show'  [" + str.tostring(maxOBs) + "]")
    gRow(8, "Only blocks that swept an HTF high/low", "Set 'Higher Timeframe for Confirmation', e.g. 4h on a 15m chart  [" + (useHTF ? htf : "off") + "]")
    gRow(9, "Alerts",                        "Tick the two alert inputs, then create an alert with 'Any alert() function call'")
