
//@version=6
indicator("Roman Trade Setup (H12 to H1)", "Roman Setup", overlay = true,
     max_boxes_count = 50, max_labels_count = 50, max_lines_count = 50)
var string gH = "1 | HTF (bias engine)"
htfTf      = input.timeframe("720", "HTF timeframe",                group = gH)
htfPivot   = input.int(3,  "HTF pivot length", minval = 1, maxval = 20, group = gH)
confirmHtf = input.bool(true, "Act only on CLOSED HTF bars (no repaint)", group = gH)
var string gL = "2 | LTF (execution)"
ltfPivot   = input.int(3, "LTF pivot length", minval = 1, maxval = 20, group = gL)
ltfAlign   = input.bool(true, "LTF MSS must align with HTF bias",    group = gL)
mssGate    = input.string("Zone tap or SFP", "LTF MSS also requires", options = ["None", "Zone tap or SFP", "Zone tap", "SFP"], group = gL)
gateWin    = input.int(24, "Setup window (chart bars)", minval = 1, group = gL)
var string gZ = "3 | Zone management (strict)"
ageUnitIn  = input.string("HTF bars", "Zone age counted in", options = ["HTF bars", "Chart bars"], group = gZ)
maxAge     = input.int(12,  "Max zone age",                   minval = 1,   group = gZ)
maxDist    = input.float(10.0, "Max distance from price (%)   0 = off", minval = 0.0, step = 0.5, group = gZ)
keepNewest = input.bool(true, "Always keep newest zone per direction", group = gZ)
maxHeight  = input.float(3.5, "Max zone height (%)          0 = off", minval = 0.0, step = 0.5, group = gZ)
hideOpp    = input.bool(false, "Delete opposing zones on bias flip", group = gZ)
maxPerSide = input.int(2,   "Max zones per direction",        minval = 1, maxval = 2, group = gZ)
extendBars = input.int(10,  "Extend zones right (bars)",      minval = 0,   group = gZ)
useBody    = input.bool(true, "Use candle body for Order Block", group = gZ)
var string gV = "4 | Visuals"
showZones  = input.bool(true, "Show zones",         group = gV)
showFib    = input.bool(true, "Show 50% fib",       group = gV)
showSfp    = input.bool(true, "Show HTF SFP label", group = gV)
showMss    = input.bool(true, "Show LTF MSS label", group = gV)
showHtfMk  = input.bool(true, "Mark HTF MSS events (diagnostic)", group = gV)
showTable  = input.bool(true, "Show info table",    group = gV)
tblPosIn   = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = gV)
tblSizeIn  = input.string("Normal", "Table text size", options = ["Small", "Normal", "Large", "Huge"], group = gV)
var string gC = "5 | Colors"
cObBullBd  = input.color(color.new(#26A69A, 0),  "Bull OB border",        group = gC)
cObBullBg  = input.color(color.new(#26A69A, 85), "Bull OB fill",          group = gC)
cObBearBd  = input.color(color.new(#EF5350, 0),  "Bear OB border",        group = gC)
cObBearBg  = input.color(color.new(#EF5350, 85), "Bear OB fill",          group = gC)
cBrBullBd  = input.color(color.new(#2962FF, 0),  "Bull breaker border",   group = gC)
cBrBullBg  = input.color(color.new(#2962FF, 88), "Bull breaker fill",     group = gC)
cBrBearBd  = input.color(color.new(#FF9800, 0),  "Bear breaker border",   group = gC)
cBrBearBg  = input.color(color.new(#FF9800, 88), "Bear breaker fill",     group = gC)
cFib       = input.color(color.new(#B39DDB, 0),  "50% fib line",          group = gC)
cUp        = input.color(color.new(#26A69A, 0),  "Bullish text/label",    group = gC)
cDn        = input.color(color.new(#EF5350, 0),  "Bearish text/label",    group = gC)
cTblBg     = input.color(color.new(#1E222D, 10), "Table background",      group = gC)
cTblTx     = input.color(color.new(#D1D4DC, 0),  "Table text",            group = gC)
var string gR = "6 | Retest & counter-trend (rev 6)"
thinBody   = input.float(0.25, "Thin body -> use wick (body < x HTF ATR)   0 = off", minval = 0.0, step = 0.05, group = gR)
showBrk    = input.bool(true, "Show broken HTF level (retest line)", group = gR)
brkTap     = input.bool(true, "Retest of broken level counts as a zone tap", group = gR)
ctMode     = input.bool(false, "Counter-trend MSS after an opposite HTF SFP", group = gR)
cBrk       = input.color(color.new(#787B86, 0), "Broken level line", group = gR)
showFlip   = input.bool(true, "Show next HTF MSS levels (bias flip lines)", group = gR)
if barstate.isfirst and timeframe.in_seconds(htfTf) <= timeframe.in_seconds(timeframe.period)
    runtime.error("HTF timeframe must be higher than the chart timeframe.")
barMs = timeframe.in_seconds(timeframe.period) * 1000
tblSize = switch tblSizeIn
    "Small" => size.small
    "Large" => size.large
    "Huge"  => size.huge
    => size.normal
f_htf(int off) =>
    var float swHi   = na      // last confirmed HTF swing high
    var float swLo   = na      // last confirmed HTF swing low
    var bool  hiDone = true    // swing already broken? (prevents signal spam)
    var bool  loDone = true
    var float obTop  = na      // order block of the LAST bias event
    var float obBot  = na
    var int   obTm   = na
    var float fib50  = na
    var float bearT  = na      // last bearish HTF candle (source for bull OB)
    var float bearB  = na
    var int   bearTm = na
    var float bullT  = na      // last bullish HTF candle (source for bear OB)
    var float bullB  = na
    var int   bullTm = na
    var float loLeg  = na      // lowest low since swHi formed  (origin of a bull break)
    var float hiLeg  = na      // highest high since swLo formed (origin of a bear break)
    var float brkLvl = na      // the swing level the LAST bias event closed through
    atrH = ta.atr(14)
    ph  = ta.pivothigh(high, htfPivot, htfPivot)
    pl  = ta.pivotlow(low,  htfPivot, htfPivot)
    loN = ta.lowest(low,   htfPivot)   // the bars after a just-confirmed pivot
    hiN = ta.highest(high, htfPivot)
    if not na(ph)
        swHi   := ph
        hiDone := false
        loLeg  := loN
    else if not na(swHi)
        loLeg  := na(loLeg) ? low : math.min(loLeg, low)
    if not na(pl)
        swLo   := pl
        loDone := false
        hiLeg  := hiN
    else if not na(swLo)
        hiLeg  := na(hiLeg) ? high : math.max(hiLeg, high)
    bullSfp = not na(swLo) and not loDone and low  < swLo and close > swLo
    bearSfp = not na(swHi) and not hiDone and high > swHi and close < swHi
    bullMss = not na(swHi) and not hiDone and close > swHi
    bearMss = not na(swLo) and not loDone and close < swLo
    if bullMss
        hiDone := true
        fib50  := na(loLeg) ? na : (swHi + loLeg) / 2.0
        obTop  := bearT
        obBot  := bearB
        obTm   := bearTm
        brkLvl := swHi
    if bearMss
        loDone := true
        fib50  := na(hiLeg) ? na : (swLo + hiLeg) / 2.0
        obTop  := bullT
        obBot  := bullB
        obTm   := bullTm
        brkLvl := swLo
    bullFlip = hiDone ? na : swHi
    bearFlip = loDone ? na : swLo
    bool bodyOk = useBody and not (thinBody > 0.0 and not na(atrH) and math.abs(close - open) < thinBody * atrH)
    if close < open
        bearT  := bodyOk ? open : high
        bearB  := bodyOk ? close : low
        bearTm := time
    if close > open
        bullT  := bodyOk ? close : high
        bullB  := bodyOk ? open : low
        bullTm := time
    [bullMss[off], bearMss[off], obTop[off], obBot[off], obTm[off], fib50[off],
     bullSfp[off], bearSfp[off], high[off], low[off], time[off], brkLvl[off],
     bullFlip[off], bearFlip[off]]
htfOff  = confirmHtf ? 1 : 0
htfLook = confirmHtf ? barmerge.lookahead_on : barmerge.lookahead_off
[rBull, rBear, obT, obB, obTm, fibRaw, rSfpB, rSfpS, rHtfHi, rHtfLo, rTime, brkRaw, upFlip, dnFlip] =
     request.security(syminfo.tickerid, htfTf, f_htf(htfOff), lookahead = htfLook)
htfNew = not na(rTime) and not na(rTime[1]) and rTime != rTime[1]
var int htfBarNo = 0
if htfNew
    htfBarNo += 1
nowUnit = ageUnitIn == "HTF bars" ? htfBarNo : bar_index
evBull  = rBull and (htfNew or not rBull[1])
evBear  = rBear and (htfNew or not rBear[1])
evSfpB  = rSfpB and (htfNew or not rSfpB[1])
evSfpS  = rSfpS and (htfNew or not rSfpS[1])
var int   bias    = 0
var float fib50   = na
var int   lastEvB = na
var label sfpLbl  = na
var int   sfpBar  = na
var int   sfpDir  = 0
var float brkLvl  = na       // broken HTF swing level of the current bias (retest line)
var bool  brkAway = false    // price has moved >= 1 LTF ATR away from it since the break
var int   ctBar   = na       // counter-trend: bar of the last SFP AGAINST the bias
var int   ctDir   = 0
var float ctWick  = na       // that SFP's wick (natural stop for a counter-trend trade)
if evBull
    bias    := 1
    fib50   := fibRaw
    lastEvB := bar_index
    brkLvl  := brkRaw
    brkAway := false
    ctBar   := na
    ctDir   := 0
    ctWick  := na
    if sfpDir == -1          // stale SFP from the old regime, drop it and its label
        label.delete(sfpLbl)
        sfpLbl := na
        sfpBar := na
        sfpDir := 0
if evBear
    bias    := -1
    fib50   := fibRaw
    lastEvB := bar_index
    brkLvl  := brkRaw
    brkAway := false
    ctBar   := na
    ctDir   := 0
    ctWick  := na
    if sfpDir == 1
        label.delete(sfpLbl)
        sfpLbl := na
        sfpBar := na
        sfpDir := 0
fibPlot = showFib and not (evBull or evBear) ? fib50 : na
plot(fibPlot, "HTF 50% Fib", color = cFib, style = plot.style_linebr, linewidth = 1, display = display.pane)
ltfAtr = ta.atr(14)
if barstate.isconfirmed and not na(brkLvl) and not na(ltfAtr) and not brkAway
    if (bias == -1 and close < brkLvl - ltfAtr) or (bias == 1 and close > brkLvl + ltfAtr)
        brkAway := true
brkPlot = showBrk and not (evBull or evBear) ? brkLvl : na
plotshape(showHtfMk and evBull, "HTF MSS up",   shape.triangleup,   location.belowbar, cUp, size = size.tiny, display = display.pane)
plotshape(showHtfMk and evBear, "HTF MSS down", shape.triangledown, location.abovebar, cDn, size = size.tiny, display = display.pane)
var box   bBox1 = na
var float bTop1 = na
var float bBot1 = na
var int   bAge1 = na
var bool  bBrk1 = false
var box   bBox2 = na
var float bTop2 = na
var float bBot2 = na
var int   bAge2 = na
var bool  bBrk2 = false
var box   sBox1 = na
var float sTop1 = na
var float sBot1 = na
var int   sAge1 = na
var bool  sBrk1 = false
var box   sBox2 = na
var float sTop2 = na
var float sBot2 = na
var int   sAge2 = na
var bool  sBrk2 = false
zDistAt(float px, float t, float b) =>
    px > t ? (px - t) / px * 100.0 : px < b ? (b - px) / px * 100.0 : 0.0
zDist(float t, float b) =>
    zDistAt(close, t, b)
refPx = barstate.isconfirmed ? close : nz(close[1], close)
zStruct(box bx, float t, float b, bool brk, bool isBull) =>
    box  rb = bx
    bool rk = brk
    if not na(rb) and barstate.isconfirmed
        if not rk
            if (isBull ? close < b : close > t)
                rk := true
        else if (isBull ? close > t : close < b)
            box.delete(rb)
            rb := na
    [rb, rk]
zShow(box bx, float t, float b, int created, bool brk, bool isBull, bool exempt) =>
    box  rb  = bx
    bool far = false
    if not na(rb)
        if barstate.isconfirmed and not exempt and nowUnit - created > maxAge
            box.delete(rb)
            rb := na
        else
            far := not exempt and maxDist > 0.0 and zDistAt(refPx, t, b) > maxDist
            bool  up = isBull != brk      // side the zone acts for right now
            color bg = brk ? (up ? cBrBullBg : cBrBearBg) : (up ? cObBullBg : cObBearBg)
            color bd = brk ? (up ? cBrBullBd : cBrBearBd) : (up ? cObBullBd : cObBearBd)
            box.set_bgcolor(rb,      far ? color.new(bg, 100) : bg)
            box.set_border_color(rb, far ? color.new(bd, 100) : bd)
            box.set_right(rb, time + barMs * extendBars)
    [rb, far]
zNewer(int cur, int stamp, bool live) =>
    live and (na(cur) or stamp > cur) ? stamp : cur
[nb1, nk1] = zStruct(bBox1, bTop1, bBot1, bBrk1, true)
bBox1 := nb1
bBrk1 := nk1
[nb2, nk2] = zStruct(bBox2, bTop2, bBot2, bBrk2, true)
bBox2 := nb2
bBrk2 := nk2
[ns1, nl1] = zStruct(sBox1, sTop1, sBot1, sBrk1, false)
sBox1 := ns1
sBrk1 := nl1
[ns2, nl2] = zStruct(sBox2, sTop2, sBot2, sBrk2, false)
sBox2 := ns2
sBrk2 := nl2
if hideOpp and (evBull or evBear)
    if not na(bBox1) and bBrk1 == evBull
        box.delete(bBox1)
        bBox1 := na
    if not na(bBox2) and bBrk2 == evBull
        box.delete(bBox2)
        bBox2 := na
    if not na(sBox1) and sBrk1 == evBear
        box.delete(sBox1)
        sBox1 := na
    if not na(sBox2) and sBrk2 == evBear
        box.delete(sBox2)
        sBox2 := na
if na(bBox1) and not na(bBox2)
    bBox1 := bBox2
    bTop1 := bTop2
    bBot1 := bBot2
    bAge1 := bAge2
    bBrk1 := bBrk2
    bBox2 := na
if na(sBox1) and not na(sBox2)
    sBox1 := sBox2
    sTop1 := sTop2
    sBot1 := sBot2
    sAge1 := sAge2
    sBrk1 := sBrk2
    sBox2 := na
int newUp = na
int newDn = na
newUp := zNewer(newUp, bAge1, not na(bBox1) and not bBrk1)
newUp := zNewer(newUp, bAge2, not na(bBox2) and not bBrk2)
newUp := zNewer(newUp, sAge1, not na(sBox1) and sBrk1)
newUp := zNewer(newUp, sAge2, not na(sBox2) and sBrk2)
newDn := zNewer(newDn, sAge1, not na(sBox1) and not sBrk1)
newDn := zNewer(newDn, sAge2, not na(sBox2) and not sBrk2)
newDn := zNewer(newDn, bAge1, not na(bBox1) and bBrk1)
newDn := zNewer(newDn, bAge2, not na(bBox2) and bBrk2)
bEx1 = keepNewest and bAge1 == (bBrk1 ? newDn : newUp)
bEx2 = keepNewest and bAge2 == (bBrk2 ? newDn : newUp)
sEx1 = keepNewest and sAge1 == (sBrk1 ? newUp : newDn)
sEx2 = keepNewest and sAge2 == (sBrk2 ? newUp : newDn)
[vb1, fb1] = zShow(bBox1, bTop1, bBot1, bAge1, bBrk1, true, bEx1)
bBox1 := vb1
bool bFar1 = fb1
[vb2, fb2] = zShow(bBox2, bTop2, bBot2, bAge2, bBrk2, true, bEx2)
bBox2 := vb2
bool bFar2 = fb2
[vs1, fs1] = zShow(sBox1, sTop1, sBot1, sAge1, sBrk1, false, sEx1)
sBox1 := vs1
bool sFar1 = fs1
[vs2, fs2] = zShow(sBox2, sTop2, sBot2, sAge2, sBrk2, false, sEx2)
sBox2 := vs2
bool sFar2 = fs2
zoneH = not na(obT) and not na(obB) ? (obT - obB) / close * 100.0 : na
okOb  = showZones and not na(obT) and not na(obB) and not na(obTm) and obT > obB and
     (maxHeight <= 0.0 or zoneH <= maxHeight)
dupBull = not na(bBox1) and obT == bTop1 and obB == bBot1
dupBear = not na(sBox1) and obT == sTop1 and obB == sBot1
if evBull and okOb and not dupBull
    if maxPerSide == 1 or na(bBox1)
        if not na(bBox1)
            box.delete(bBox1)
    else
        if not na(bBox2)
            box.delete(bBox2)
        bBox2 := bBox1
        bTop2 := bTop1
        bBot2 := bBot1
        bAge2 := bAge1
        bBrk2 := bBrk1
        bFar2 := bFar1
    bBox1 := box.new(obTm, obT, time + barMs * extendBars, obB, xloc = xloc.bar_time,
             border_color = cObBullBd, bgcolor = cObBullBg, border_width = 1)
    bTop1 := obT
    bBot1 := obB
    bAge1 := nowUnit
    bBrk1 := false
    bFar1 := false
if evBear and okOb and not dupBear
    if maxPerSide == 1 or na(sBox1)
        if not na(sBox1)
            box.delete(sBox1)
    else
        if not na(sBox2)
            box.delete(sBox2)
        sBox2 := sBox1
        sTop2 := sTop1
        sBot2 := sBot1
        sAge2 := sAge1
        sBrk2 := sBrk1
        sFar2 := sFar1
    sBox1 := box.new(obTm, obT, time + barMs * extendBars, obB, xloc = xloc.bar_time,
             border_color = cObBearBd, bgcolor = cObBearBg, border_width = 1)
    sTop1 := obT
    sBot1 := obB
    sAge1 := nowUnit
    sBrk1 := false
    sFar1 := false
sfpBull = evSfpB and bias ==  1
sfpBear = evSfpS and bias == -1
if showSfp and (sfpBull or sfpBear)
    if not na(sfpLbl)
        label.delete(sfpLbl)
    sfpLbl := label.new(rTime, sfpBull ? rHtfLo : rHtfHi, "SFP", xloc = xloc.bar_time,
         style     = sfpBull ? label.style_label_up : label.style_label_down,
         color     = color.new(sfpBull ? cUp : cDn, 20),
         textcolor = color.white, size = size.tiny)
if sfpBull or sfpBear
    sfpBar := bar_index
    sfpDir := sfpBull ? 1 : -1
ctSfpB = ctMode and evSfpB and bias == -1
ctSfpS = ctMode and evSfpS and bias ==  1
var label ctLbl = na
if showSfp and (ctSfpB or ctSfpS)
    if not na(ctLbl)
        label.delete(ctLbl)
    ctLbl := label.new(rTime, ctSfpB ? rHtfLo : rHtfHi, "SFP CT", xloc = xloc.bar_time,
         style     = ctSfpB ? label.style_label_up : label.style_label_down,
         color     = color.new(ctSfpB ? cUp : cDn, 50),
         textcolor = color.white, size = size.tiny)
if ctSfpB or ctSfpS
    ctBar  := bar_index
    ctDir  := ctSfpB ? 1 : -1
    ctWick := ctSfpB ? rHtfLo : rHtfHi
zTouch(box bx, float t, float b) =>
    not na(bx) and low <= t and high >= b
var int tapUpBar = na
var int tapDnBar = na
bT1 = zTouch(bBox1, bTop1, bBot1)
bT2 = zTouch(bBox2, bTop2, bBot2)
sT1 = zTouch(sBox1, sTop1, sBot1)
sT2 = zTouch(sBox2, sTop2, sBot2)
if (bT1 and not bBrk1) or (bT2 and not bBrk2) or (sT1 and sBrk1) or (sT2 and sBrk2)
    tapUpBar := bar_index
if (sT1 and not sBrk1) or (sT2 and not sBrk2) or (bT1 and bBrk1) or (bT2 and bBrk2)
    tapDnBar := bar_index
if brkTap and brkAway and not na(brkLvl)
    if bias == -1 and high >= brkLvl
        tapDnBar := bar_index
    if bias == 1 and low <= brkLvl
        tapUpBar := bar_index
inWin(int b) =>
    not na(b) and bar_index - b <= gateWin
tapUp = inWin(tapUpBar)
tapDn = inWin(tapDnBar)
sfpUp = sfpDir ==  1 and inWin(sfpBar)
sfpDn = sfpDir == -1 and inWin(sfpBar)
gateUp = switch mssGate
    "Zone tap or SFP" => tapUp or sfpUp
    "Zone tap"        => tapUp
    "SFP"             => sfpUp
    => true
gateDn = switch mssGate
    "Zone tap or SFP" => tapDn or sfpDn
    "Zone tap"        => tapDn
    "SFP"             => sfpDn
    => true
var float lHi     = na
var float lLo     = na
var bool  lHiDone = true
var bool  lLoDone = true
lph = ta.pivothigh(high, ltfPivot, ltfPivot)
lpl = ta.pivotlow(low,  ltfPivot, ltfPivot)
if not na(lph)
    lHi     := lph
    lHiDone := false
if not na(lpl)
    lLo     := lpl
    lLoDone := false
rawMssUp = barstate.isconfirmed and not na(lHi) and not lHiDone and close > lHi
rawMssDn = barstate.isconfirmed and not na(lLo) and not lLoDone and close < lLo
if rawMssUp
    lHiDone := true
if rawMssDn
    lLoDone := true
alnUp = rawMssUp and (not ltfAlign or bias ==  1) and gateUp
alnDn = rawMssDn and (not ltfAlign or bias == -1) and gateDn
ctArmUp = ctMode and ctDir ==  1 and bias == -1 and inWin(ctBar)
ctArmDn = ctMode and ctDir == -1 and bias ==  1 and inWin(ctBar)
mssCtUp = rawMssUp and ctArmUp and not alnUp
mssCtDn = rawMssDn and ctArmDn and not alnDn
mssUp = alnUp or mssCtUp
mssDn = alnDn or mssCtDn
var label mssLbl = na
if showMss and (mssUp or mssDn)
    if not na(mssLbl)
        label.delete(mssLbl)
    bool isCt = mssUp ? mssCtUp : mssCtDn
    mssLbl := label.new(bar_index, mssUp ? low : high, isCt ? "MSS CT" : "MSS",
         style     = mssUp ? label.style_label_up : label.style_label_down,
         color     = color.new(mssUp ? cUp : cDn, isCt ? 75 : 55),
         textcolor = cTblTx, size = size.tiny)
var int lastMssBar = na
var int lastMssDir = 0
if mssUp or mssDn
    lastMssBar := bar_index
    lastMssDir := mssUp ? 1 : -1
xArmUp = gateUp and (not ltfAlign or bias ==  1)
xArmDn = gateDn and (not ltfAlign or bias == -1)
zTopOut(box bx, float t) => na(bx) ? na : t
zBotOut(box bx, float b) => na(bx) ? na : b
zStOut(box bx, bool brk, bool far) => na(bx) ? na : (brk ? 1 : 0) + (far ? 2 : 0)
plot(bias,                                       "x_bias",       display = display.data_window)
plot(fib50,                                      "x_fib50",      display = display.data_window)
plot(na(lastEvB) ? na : bar_index - lastEvB,     "x_htfMssAgo",  display = display.data_window)
plot(sfpDir,                                     "x_sfpDir",     display = display.data_window)
plot(na(sfpBar) ? na : bar_index - sfpBar,       "x_sfpAgo",     display = display.data_window)
plot(lastMssDir,                                 "x_mssDir",     display = display.data_window)
plot(na(lastMssBar) ? na : bar_index - lastMssBar, "x_mssAgo",   display = display.data_window)
plot(na(tapUpBar) ? na : bar_index - tapUpBar,   "x_tapUpAgo",   display = display.data_window)
plot(na(tapDnBar) ? na : bar_index - tapDnBar,   "x_tapDnAgo",   display = display.data_window)
plot(xArmUp ? 1 : 0,                             "x_armUp",      display = display.data_window)
plot(xArmDn ? 1 : 0,                             "x_armDn",      display = display.data_window)
plot(zTopOut(bBox1, bTop1), "x_b1Top", display = display.data_window)
plot(zBotOut(bBox1, bBot1), "x_b1Bot", display = display.data_window)
plot(zStOut(bBox1, bBrk1, bFar1), "x_b1St", display = display.data_window)
plot(zTopOut(bBox2, bTop2), "x_b2Top", display = display.data_window)
plot(zBotOut(bBox2, bBot2), "x_b2Bot", display = display.data_window)
plot(zStOut(bBox2, bBrk2, bFar2), "x_b2St", display = display.data_window)
plot(zTopOut(sBox1, sTop1), "x_s1Top", display = display.data_window)
plot(zBotOut(sBox1, sBot1), "x_s1Bot", display = display.data_window)
plot(zStOut(sBox1, sBrk1, sFar1), "x_s1St", display = display.data_window)
plot(zTopOut(sBox2, sTop2), "x_s2Top", display = display.data_window)
plot(zBotOut(sBox2, sBot2), "x_s2Bot", display = display.data_window)
plot(zStOut(sBox2, sBrk2, sFar2), "x_s2St", display = display.data_window)
plot(brkLvl,                                     "x_brkLvl",     display = display.data_window)
plot(brkAway ? 1 : 0,                            "x_brkAway",    display = display.data_window)
plot(ctDir,                                      "x_ctDir",      display = display.data_window)
plot(na(ctBar) ? na : bar_index - ctBar,         "x_ctAgo",      display = display.data_window)
plot(ctWick,                                     "x_ctWick",     display = display.data_window)
plot(ctArmUp ? 1 : ctArmDn ? -1 : 0,             "x_ctArm",      display = display.data_window)
plot(upFlip,                                     "x_bullFlip",   display = display.data_window)
plot(dnFlip,                                     "x_bearFlip",   display = display.data_window)
